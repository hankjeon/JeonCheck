<Window x:Class="JeonCheck.Views.RulesetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="검사 규칙(Ruleset) 선택 및 관리"
        Icon="pack://application:,,,/Resources/app_icon.ico"
        Width="1050" Height="740"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="#E6EDF3">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="230" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 상단 타이틀 및 설명 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="⚙ 정적 분석 검사 규칙(Ruleset) 설정" FontSize="17" FontWeight="Bold" Foreground="#E6EDF3" />
            <TextBlock Text="프로젝트 특성에 맞게 검사할 규칙을 켜거나(ON) 의도적으로 허용하는 규칙을 제외(OFF)할 수 있습니다."
                       FontSize="12" Foreground="#9DA7B3" Margin="0,3,0,0" />
        </StackPanel>

        <!-- 필터 및 일괄 선택 바 -->
        <Border Grid.Row="1" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <TextBlock Text="분류:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#9DA7B3" />
                <ComboBox x:Name="CategoryComboBox" Width="160" VerticalAlignment="Center" Margin="0,0,14,0"
                          SelectionChanged="CategoryComboBox_SelectionChanged" />

                <TextBlock Text="검색:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#9DA7B3" />
                <TextBox x:Name="SearchTextBox" Width="210" VerticalAlignment="Center" Padding="6,4"
                         Background="#1E1E1E" Foreground="#E6EDF3" BorderBrush="#4E5157"
                         TextChanged="SearchTextBox_TextChanged" />

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="목록 전체 선택" Style="{StaticResource DarkButtonStyle}" Click="SelectAll_Click" ToolTip="현재 카테고리·검색어로 걸러져 목록에 보이는 규칙만 모두 켭니다" />
                    <Button Content="목록 전체 해제" Style="{StaticResource DarkButtonStyle}" Click="UnselectAll_Click" ToolTip="현재 카테고리·검색어로 걸러져 목록에 보이는 규칙만 모두 끕니다" />
                    <Button Content="필수/치명만 선택" Style="{StaticResource DarkButtonStyle}" Click="SelectRequiredOnly_Click" ToolTip="전체 규칙 중 필수·치명·강제 등급만 켜고 나머지는 끕니다 (목록 필터와 무관)" />
                    <Button Content="형변환 집중 선택" Style="{StaticResource DarkButtonStyle}" Click="SelectConversionOnly_Click" ToolTip="전체 규칙 중 형변환 관련 규칙만 켜고 나머지는 끕니다 (목록 필터와 무관)" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 규칙 목록 DataGrid -->
        <DataGrid x:Name="RulesDataGrid" Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  Background="#1E1E1E"
                  RowBackground="#252526"
                  AlternatingRowBackground="#202022"
                  Foreground="#E6EDF3"
                  BorderBrush="#3E3E42"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#333337"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  SelectionChanged="RulesDataGrid_SelectionChanged">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#2D2D30" />
                    <Setter Property="Foreground" Value="#E6EDF3" />
                    <Setter Property="Padding" Value="8,6" />
                    <Setter Property="BorderBrush" Value="#3E3E42" />
                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="6,5" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#094771" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="검사 포함" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="75" />
                <DataGridTextColumn Header="규칙 ID" Binding="{Binding Id}" IsReadOnly="True" Width="170" FontFamily="{StaticResource CodingFont}" />
                <DataGridTextColumn Header="분류" Binding="{Binding Category}" IsReadOnly="True" Width="130" />
                <DataGridTextColumn Header="의무 등급" Binding="{Binding Obligation}" IsReadOnly="True" Width="115" />
                <DataGridTextColumn Header="규칙명" Binding="{Binding Title}" IsReadOnly="True" Width="240" />
                <DataGridTextColumn Header="한 줄 요약 설명" Binding="{Binding Summary}" IsReadOnly="True" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- 하단 선택한 규칙 상세 설명 및 코드 예시 미리보기 -->
        <Border Grid.Row="3" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,10,0,10">
            <Grid x:Name="DetailPreviewPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock x:Name="PreviewTitleText" Text="규칙을 선택하면 상세 설명이 표시됩니다." FontSize="14" FontWeight="Bold" Foreground="#58A6FF" TextWrapping="Wrap" />
                    <TextBlock x:Name="PreviewMetaText" Text="" FontSize="11.5" Foreground="#9DA7B3" Margin="0,3,0,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="145">
                        <TextBlock x:Name="PreviewDescText" Text="" Foreground="#E6EDF3" TextWrapping="Wrap" LineHeight="20" />
                    </ScrollViewer>
                </StackPanel>

                <Border Grid.Column="1" Background="#1E1E1E" BorderBrush="#6E3630" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,8,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="❌ 위반 코드 예시 (Bad)" FontWeight="Bold" Foreground="#F85149" Margin="0,0,0,6" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBlock x:Name="PreviewBadCodeText" FontFamily="{StaticResource CodingFont}" FontSize="12" Foreground="#E6EDF3" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Background="#1E1E1E" BorderBrush="#238636" BorderThickness="1" CornerRadius="4" Padding="8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="✅ 안전한 개선 예시 (Good)" FontWeight="Bold" Foreground="#3FB950" Margin="0,0,0,6" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBlock x:Name="PreviewGoodCodeText" FontFamily="{StaticResource CodingFont}" FontSize="12" Foreground="#E6EDF3" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 하단 닫기/적용 바 -->
        <DockPanel Grid.Row="4">
            <TextBlock x:Name="ActiveCountText" Text="활성 규칙: 0개" VerticalAlignment="Center" Foreground="#9DA7B3" FontWeight="SemiBold" />
            <Button Content="확인 및 적용" DockPanel.Dock="Right" Width="130" Style="{StaticResource PrimaryRunButtonStyle}" Click="CloseButton_Click" />
        </DockPanel>
    </Grid>
</Window>
