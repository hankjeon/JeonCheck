<Window x:Class="JeonCheck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:JeonCheck.Models"
        xmlns:views="clr-namespace:JeonCheck.Views"
        Title="{Binding CurrentProjectTitle}"
        Icon="pack://application:,,,/Resources/app_icon.ico"
        Width="1380" Height="860"
        MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_Closing"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        Background="#1E1E1E"
        Foreground="#E6EDF3">
    <Window.Resources>
        <Style x:Key="SeverityToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#252526" />
            <Setter Property="BorderBrush" Value="#4E5157" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#30363D" />
                                <Setter Property="BorderBrush" Value="#58A6FF" />
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkTopMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E6EDF3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                                <Popup x:Name="PART_Popup"
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       Placement="Bottom"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Fade">
                                    <Border Background="#252526" BorderBrush="#454545" BorderThickness="1" Padding="2" MinWidth="220">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3E3E42" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3E3E42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkSubMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E6EDF3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="0,0,24,0" />
                                <TextBlock x:Name="GestureText" Grid.Column="1" Text="{TemplateBinding InputGestureText}" Foreground="#8B949E" FontSize="11.5" VerticalAlignment="Center" />
                                <TextBlock x:Name="SubmenuArrow" Grid.Column="1" Text="▸" Foreground="#8B949E" FontSize="12" VerticalAlignment="Center" Visibility="Collapsed" />
                                <Popup x:Name="PART_Popup"
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       Placement="Right"
                                       HorizontalOffset="-2"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Fade">
                                    <Border Background="#252526" BorderBrush="#454545" BorderThickness="1" Padding="2" MinWidth="280">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="GestureText" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#094771" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="SubmenuArrow" Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#094771" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="SubmenuArrow" Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6E7681" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Margin" Value="6,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#3E3E42" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FloatingEncodingButtonStyle" BasedOn="{StaticResource DarkButtonStyle}" TargetType="Button">
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="11.5" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FloatingPrettifyToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#3A3D41" />
            <Setter Property="Foreground" Value="#E6EDF3" />
            <Setter Property="BorderBrush" Value="#4E5157" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4B4F55" />
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#18324C" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#58A6FF" />
                                <Setter Property="Foreground" Value="#79C0FF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Opacity" Value="0.92" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#1F4060" />
                                <Setter Property="Opacity" Value="1" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- 1. 상단 표준 메뉴바 (파일 / 도움말) + 분석 옵션 및 실행 툴바 -->
        <Border Grid.Row="0" Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
            <StackPanel>
                <!-- 1.1 표준 메뉴바: 파일(F) | 도움말(H) -->
                <Border Background="#2D2D30" BorderBrush="#38383D" BorderThickness="0,0,0,1" Padding="4,1">
                    <Menu Background="Transparent" Foreground="#E6EDF3" FontSize="12.5">
                        <MenuItem Header="파일(_F)" Style="{StaticResource DarkTopMenuItemStyle}" SubmenuOpened="FileMenu_SubmenuOpened">
                            <MenuItem Header="📄 새 프로젝트(_N)" InputGestureText="Ctrl+N" Style="{StaticResource DarkSubMenuItemStyle}" Click="NewProject_Click" />
                            <MenuItem Header="📂 프로젝트 열기(_O)..." InputGestureText="Ctrl+O" Style="{StaticResource DarkSubMenuItemStyle}" Click="OpenProject_Click" />
                            <MenuItem x:Name="RecentProjectsMenuItem" Header="🕒 최근 사용한 프로젝트(_R)" Style="{StaticResource DarkSubMenuItemStyle}" />
                            <Separator Style="{StaticResource DarkMenuSeparatorStyle}" />
                            <MenuItem Header="💾 저장(_S)" InputGestureText="Ctrl+S" Style="{StaticResource DarkSubMenuItemStyle}" Click="SaveProject_Click" />
                            <MenuItem Header="💾 다른 이름으로 저장(_A)..." InputGestureText="Ctrl+Shift+S" Style="{StaticResource DarkSubMenuItemStyle}" Click="SaveProjectAs_Click" />
                            <Separator Style="{StaticResource DarkMenuSeparatorStyle}" />
                            <MenuItem Header="🧪 샘플 프로젝트 로드(_L)" Style="{StaticResource DarkSubMenuItemStyle}" Click="LoadSample_Click" />
                            <Separator Style="{StaticResource DarkMenuSeparatorStyle}" />
                            <MenuItem Header="종료(_X)" InputGestureText="Alt+F4" Style="{StaticResource DarkSubMenuItemStyle}" Click="ExitApp_Click" />
                        </MenuItem>
                        <MenuItem Header="도움말(_H)" Style="{StaticResource DarkTopMenuItemStyle}">
                            <MenuItem Header="ℹ️ 전검사 정보(_A)..." Style="{StaticResource DarkSubMenuItemStyle}" Click="OpenAboutWindow_Click" />
                            <MenuItem Header="📜 히스토리(_H)..." Style="{StaticResource DarkSubMenuItemStyle}" Click="OpenHistoryWindow_Click" />
                        </MenuItem>
                    </Menu>
                </Border>

                <!-- 1.2 분석 옵션 및 정적 분석 시작 툴바 (방안 A: 깔끔한 1단 통합) -->
                <Border Background="#252528" Padding="12,6">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Content="{Binding RulesetButtonText}"
                                    Style="{StaticResource DarkButtonStyle}"
                                    Click="OpenRulesetWindow_Click"
                                    Margin="0,0,8,0" />
                            <Button Content="■ 분석 취소"
                                    Style="{StaticResource DarkButtonStyle}"
                                    Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Click="CancelAnalysis_Click"
                                    ToolTip="진행 중인 정적 분석을 중지합니다 (실행 중인 분석 도구 프로세스를 종료하고 임시 파일을 정리합니다)"
                                    Margin="0,0,8,0" />
                            <Button Content="{Binding RunButtonText}"
                                    Style="{StaticResource PrimaryRunButtonStyle}"
                                    IsEnabled="{Binding CanAnalyze}"
                                    Click="RunAnalysis_Click" />
                        </StackPanel>

                        <WrapPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,18,2">
                                <TextBlock Text="🎯 타겟 프로세서:" VerticalAlignment="Center" Foreground="#9DA7B3" Margin="0,0,6,0" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding TargetPresets}"
                                          SelectedItem="{Binding SelectedTargetPreset}"
                                          DisplayMemberPath="Name"
                                          Width="275"
                                          VerticalAlignment="Center"
                                          ToolTip="{Binding SelectedTargetPreset.Description}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,18,2">
                                <TextBlock Text="C 표준:" VerticalAlignment="Center" Foreground="#9DA7B3" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding CStandards}"
                                          SelectedItem="{Binding SelectedCStandard}"
                                          Width="72"
                                          VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,18,2">
                                <TextBlock Text="-D 매크로:" VerticalAlignment="Center" Foreground="#9DA7B3" Margin="0,0,6,0" />
                                <TextBox Text="{Binding CustomDefines, UpdateSourceTrigger=PropertyChanged}"
                                         Width="165"
                                         VerticalAlignment="Center"
                                         Padding="5,3"
                                         Background="#1E1E1E"
                                         Foreground="#E6EDF3"
                                         BorderBrush="#4E5157"
                                         FontFamily="{StaticResource CodingFont}"
                                         ToolTip="추가 매크로 정의 (예: ENABLE_EXPERIMENTAL_LUT=1, BOARD_V2)" />
                            </StackPanel>

                            <CheckBox Content="모든 #ifdef 분기 강제 검사 (--force)"
                                      IsChecked="{Binding ForceAllIfdefConfigs}"
                                      Foreground="#E6EDF3"
                                      VerticalAlignment="Center"
                                      Margin="0,2,18,2"
                                      ToolTip="체크 시 정의되지 않은 #ifdef 블록까지 모든 조합(--force)을 강제로 분석합니다." />

                            <CheckBox Content="Clang-Tidy (CERT-C / 심층 분석) 포함"
                                      IsChecked="{Binding EnableClangTidy}"
                                      Foreground="#79C0FF"
                                      FontWeight="SemiBold"
                                      VerticalAlignment="Center"
                                      Margin="0,2,0,2"
                                      ToolTip="Cppcheck 외에 내장된 Clang-Tidy 엔진을 함께 실행하여 CERT-C, bugprone, Clang Static Analyzer 경로 추적 검사를 수행합니다." />
                        </WrapPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- 2. 중앙 메인 3열 레이아웃 (좌측: 대상/비대상 분리 트리 | 중앙: 코드뷰어 + 결과탭 | 우측: 상세 한글 해설) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" MinWidth="240" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="480" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="390" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- 2.1 좌측 패널: 상하 분리 (상단: 🟢 검사 대상 코드 / 하단: ⚪ 비대상·참조 코드) -->
            <Grid Grid.Column="0" Background="#252526">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="160" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="140" />
                </Grid.RowDefinitions>

                <!-- 좌측 상단: 검사대상 코드 트리 -->
                <Border Grid.Row="0" BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#1F3225" BorderBrush="#2EA043" BorderThickness="0,0,0,1" Padding="8,6">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <Button Content="+" Width="26" Style="{StaticResource DarkButtonStyle}" Padding="0,1" FontSize="13" FontWeight="Bold" Click="AddTargetItems_Click"
                                            ToolTip="파일(Ctrl 다중 선택) 또는 폴더 전체 추가" />
                                    <Button Content="-" Width="26" Style="{StaticResource DarkButtonStyle}" Padding="0,1" FontSize="13" FontWeight="Bold" Click="RemoveTargetNode_Click"
                                            ToolTip="선택한 파일 또는 폴더(하위 전체) 제거" />
                                </StackPanel>
                                <TextBlock Text="{Binding TargetFilesSummary}" FontWeight="Bold" Foreground="#56D364" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <TreeView x:Name="TargetTreeView"
                                  ItemsSource="{Binding TargetRoots}"
                                  Background="#252526"
                                  Foreground="#E6EDF3"
                                  BorderThickness="0"
                                  Padding="4"
                                  SelectedItemChanged="TargetTreeView_SelectedItemChanged">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="Foreground" Value="#E6EDF3" />
                                    <Setter Property="Padding" Value="2,1" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type models:SourceTreeNode}" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="2,0" ToolTip="{Binding FullPath}">
                                        <TextBlock Text="{Binding IconText}" Margin="0,0,5,0" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        <Border Background="#5A1E21" CornerRadius="8" Padding="6,1" Margin="8,0,0,0"
                                                Visibility="{Binding HasDefects, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding DefectBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#FF7B72" />
                                        </Border>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>
                </Border>

                <!-- 좌측 중앙: 상하 이동 전환 바 (▼ 비대상으로 제외 / ▲ 검사 대상으로 포함) -->
                <Border Grid.Row="1" Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="0,1" Padding="6,5">
                    <UniformGrid Columns="2">
                        <Button Content="▼ 비대상으로 제외" Style="{StaticResource DarkButtonStyle}" FontSize="11.5" Click="MoveToNonTarget_Click"
                                ToolTip="상단 검사 대상에서 선택한 폴더나 파일을 하단 비대상/참조 목록으로 이동합니다." />
                        <Button Content="▲ 검사 대상으로 포함" Style="{StaticResource DarkButtonStyle}" FontSize="11.5" Click="MoveToTarget_Click"
                                ToolTip="하단 비대상에서 선택한 폴더나 파일을 상단 검사 대상 목록으로 이동합니다." />
                    </UniformGrid>
                </Border>

                <!-- 좌측 하단: 참조코드(비대상) 트리 -->
                <Border Grid.Row="2">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="0,0,0,1" Padding="8,6">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <Button Content="+" Width="26" Style="{StaticResource DarkButtonStyle}" Padding="0,1" FontSize="13" FontWeight="Bold" Click="AddNonTargetItems_Click"
                                            ToolTip="파일(Ctrl 다중 선택) 또는 폴더 전체 추가" />
                                    <Button Content="-" Width="26" Style="{StaticResource DarkButtonStyle}" Padding="0,1" FontSize="13" FontWeight="Bold" Click="RemoveNonTargetNode_Click"
                                            ToolTip="선택한 파일 또는 폴더(하위 전체) 제거" />
                                </StackPanel>
                                <TextBlock Text="{Binding NonTargetFilesSummary}" FontWeight="Bold" Foreground="#9DA7B3" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <TextBlock DockPanel.Dock="Top" Text="※ 직접 결함 검사는 제외하며 헤더 참조(-I) 경로로만 활용됩니다."
                                   FontSize="11" Foreground="#8B949E" Background="#202022" Padding="8,4" />

                        <TreeView x:Name="NonTargetTreeView"
                                  ItemsSource="{Binding NonTargetRoots}"
                                  Background="#202022"
                                  Foreground="#9DA7B3"
                                  BorderThickness="0"
                                  Padding="4"
                                  SelectedItemChanged="NonTargetTreeView_SelectedItemChanged">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="Foreground" Value="#9DA7B3" />
                                    <Setter Property="Padding" Value="2,1" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type models:SourceTreeNode}" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="2,0" ToolTip="{Binding FullPath}">
                                        <TextBlock Text="{Binding IconText}" Margin="0,0,5,0" Opacity="0.75" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        <TextBlock Text="[참조/제외]" FontSize="10.5" Foreground="#6E7681" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#3E3E42" />

            <!-- 2.2 중앙 패널: 상단 코드 뷰어 (라인별 검사/미검사 표시) + 하단 결함/노트 탭 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.35*" MinHeight="220" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="1*" MinHeight="180" />
                </Grid.RowDefinitions>

                <!-- 중앙 상단: 코드 뷰어 -->
                <DockPanel Grid.Row="0" Background="#1E1E1E">
                    <!-- 코드 뷰어 헤더 바 -->
                    <Border DockPanel.Dock="Top" Background="#252526" BorderBrush="#3E3E42" BorderThickness="0,0,0,1" Padding="10,6">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="📝 외부 편집기로 열기" Style="{StaticResource DarkButtonStyle}" Padding="8,2" FontSize="11.5" Click="OpenExternalEditor_Click" />
                                <Button Content="📁 폴더 열기" Style="{StaticResource DarkButtonStyle}" Padding="8,2" FontSize="11.5" Click="OpenFileFolder_Click" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding CurrentCodeFileName}" FontWeight="Bold" FontSize="13" Foreground="#58A6FF" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding CodeStatsSummary}" FontSize="11.5" Foreground="#9DA7B3" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 코드 리스트 + 우측 결함 위치 오버뷰 바 (오류/경고/권고 3색 마커 & 클릭 즉시 스크롤) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                        </Grid.ColumnDefinitions>

                        <!-- 라인별 검사 상태 표시 코드 리스트 -->
                        <ListBox x:Name="CodeViewerListBox"
                                 Grid.Column="0"
                                 ItemsSource="{Binding CurrentFileLines}"
                             Background="#1E1E1E"
                             BorderThickness="0"
                             FontFamily="{StaticResource CodingFont}"
                             FontSize="13"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             SelectionChanged="CodeViewerListBox_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="RowBorder" Background="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RowBorder" Property="BorderBrush" Value="#58A6FF" />
                                                    <Setter TargetName="RowBorder" Property="BorderThickness" Value="0,1,0,1" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:CodeLineViewModel}">
                                <Border x:Name="LineBgBorder" Padding="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5" />
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 좌측 라인 상태 컬러바 -->
                                        <Border x:Name="StatusIndicatorBar" Grid.Column="0" Background="Transparent" />

                                        <!-- 줄 번호 -->
                                        <TextBlock Grid.Column="1" Text="{Binding LineNumber}"
                                                   Foreground="#6E7681" TextAlignment="Right" Padding="0,0,8,0" />

                                        <!-- 상태 컬러 도트 -->
                                        <Ellipse x:Name="StatusDot" Grid.Column="2" Width="8" Height="8" Fill="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                        <!-- C 코드 본문 -->
                                        <TextBlock x:Name="CodeTextBlock" Grid.Column="3" views:CodeHighlightBehavior.Spans="{Binding HighlightSpans}"
                                                   Foreground="#E6EDF3" VerticalAlignment="Center" />

                                        <!-- 인라인 결함 / 미검사 배지 및 줄 단위 즉시 예외/복원 버튼 -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="16,0,8,0" VerticalAlignment="Center">
                                            <Border x:Name="AnnotationBadge" CornerRadius="3" Padding="6,1" VerticalAlignment="Center" ToolTip="{Binding TooltipText}"
                                                    Visibility="{Binding HasInlineAnnotation, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock x:Name="AnnotationText" Text="{Binding InlineAnnotation}" FontSize="11.5" />
                                            </Border>

                                            <!-- 결함 줄 우측에 표시되는 [🔇 이 줄 예외] 버튼 -->
                                            <Button Content="🔇 이 줄 예외"
                                                    Style="{StaticResource DarkButtonStyle}"
                                                    Padding="6,1" Margin="6,0,0,0" FontSize="11"
                                                    Visibility="{Binding CanSuppressLine, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Click="InlineSuppressLine_Click"
                                                    ToolTip="이 줄의 결함을 예외(무시) 처리합니다." />

                                            <!-- 예외 처리된 줄 우측에 표시되는 [↩ 다시 검사(복원)] 버튼 -->
                                            <Button Content="↩ 다시 검사(복원)"
                                                    Style="{StaticResource DarkButtonStyle}"
                                                    Background="#3B234A" BorderBrush="#8957E5" Foreground="#D2A8FF"
                                                    Padding="6,1" Margin="6,0,0,0" FontSize="11" FontWeight="SemiBold"
                                                    Visibility="{Binding CanRestoreLine, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Click="InlineRestoreLine_Click"
                                                    ToolTip="이 줄의 예외 처리를 해제하고 다시 결함 검사에 포함합니다." />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <!-- 🟢 검사 완료 줄 -->
                                    <DataTrigger Binding="{Binding Status}" Value="Analyzed">
                                        <Setter TargetName="StatusIndicatorBar" Property="Background" Value="#2EA043" />
                                        <Setter TargetName="StatusDot" Property="Fill" Value="#3FB950" />
                                        <Setter TargetName="LineBgBorder" Property="Background" Value="#122119" />
                                    </DataTrigger>
                                    <!-- ⚪ 미검사(Skipped) 줄 -->
                                    <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                        <Setter TargetName="StatusIndicatorBar" Property="Background" Value="#484F58" />
                                        <Setter TargetName="StatusDot" Property="Fill" Value="#6E7681" />
                                        <Setter TargetName="LineBgBorder" Property="Background" Value="#161618" />
                                        <Setter TargetName="CodeTextBlock" Property="Foreground" Value="#6E7681" />
                                        <Setter TargetName="AnnotationBadge" Property="Background" Value="#282C34" />
                                        <Setter TargetName="AnnotationText" Property="Foreground" Value="#8B949E" />
                                    </DataTrigger>
                                    <!-- 🔇 사용자 예외(무시) 처리된 줄 (음영 표시 + 복원 버튼) -->
                                    <DataTrigger Binding="{Binding Status}" Value="Suppressed">
                                        <Setter TargetName="StatusIndicatorBar" Property="Background" Value="#8957E5" />
                                        <Setter TargetName="StatusDot" Property="Fill" Value="#A371F7" />
                                        <Setter TargetName="LineBgBorder" Property="Background" Value="#1F192C" />
                                        <Setter TargetName="CodeTextBlock" Property="Foreground" Value="#9E8FB2" />
                                        <Setter TargetName="AnnotationBadge" Property="Background" Value="#2E2240" />
                                        <Setter TargetName="AnnotationText" Property="Foreground" Value="#D2A8FF" />
                                    </DataTrigger>
                                    <!-- 🔵 권고(Style/Advisory) 규칙 위반 검출 줄 -->
                                    <DataTrigger Binding="{Binding Status}" Value="Advisory">
                                        <Setter TargetName="StatusIndicatorBar" Property="Background" Value="#58A6FF" />
                                        <Setter TargetName="StatusDot" Property="Fill" Value="#58A6FF" />
                                        <Setter TargetName="LineBgBorder" Property="Background" Value="#142334" />
                                        <Setter TargetName="AnnotationBadge" Property="Background" Value="#18324C" />
                                        <Setter TargetName="AnnotationText" Property="Foreground" Value="#79C0FF" />
                                        <Setter TargetName="AnnotationText" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <!-- 🟠 경고/규칙 위반 검출 줄 -->
                                    <DataTrigger Binding="{Binding Status}" Value="Warning">
                                        <Setter TargetName="StatusIndicatorBar" Property="Background" Value="#D29922" />
                                        <Setter TargetName="StatusDot" Property="Fill" Value="#D29922" />
                                        <Setter TargetName="LineBgBorder" Property="Background" Value="#342814" />
                                        <Setter TargetName="AnnotationBadge" Property="Background" Value="#4D3815" />
                                        <Setter TargetName="AnnotationText" Property="Foreground" Value="#F2CC60" />
                                        <Setter TargetName="AnnotationText" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <!-- 🔴 치명적 오류 검출 줄 -->
                                    <DataTrigger Binding="{Binding Status}" Value="Error">
                                        <Setter TargetName="StatusIndicatorBar" Property="Background" Value="#F85149" />
                                        <Setter TargetName="StatusDot" Property="Fill" Value="#F85149" />
                                        <Setter TargetName="LineBgBorder" Property="Background" Value="#3B1D20" />
                                        <Setter TargetName="AnnotationBadge" Property="Background" Value="#5C2125" />
                                        <Setter TargetName="AnnotationText" Property="Foreground" Value="#FFA198" />
                                        <Setter TargetName="AnnotationText" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 우측 결함 위치 오버뷰 마커 바 (🔴오류 / 🟠경고 / 🔵권고) -->
                        <Border Grid.Column="1"
                                Background="#18181A"
                                BorderBrush="#2D2D30"
                                BorderThickness="1,0,0,0"
                                Cursor="Hand"
                                ToolTip="전체 코드 결함 위치 미니맵 (🔴오류 / 🟠경고 / 🔵권고 - 클릭하면 해당 줄로 바로 이동합니다)"
                                SizeChanged="OverviewCanvas_SizeChanged"
                                MouseLeftButtonDown="OverviewCanvas_MouseLeftButtonDown"
                                MouseMove="OverviewCanvas_MouseMove">
                            <Canvas x:Name="OverviewCanvas" ClipToBounds="True" Background="Transparent" />
                        </Border>
                        <!-- 코드창 우측 하단 플로팅 버튼 (Prettify 들여쓰기 정리 + 인코딩 전환) -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,30,10">
                            <ToggleButton Style="{StaticResource FloatingPrettifyToggleStyle}"
                                          Content="Prettify"
                                          IsChecked="{Binding IsPrettifyEnabled, Mode=TwoWay}"
                                          Margin="0,0,6,0"
                                          ToolTip="코드 들여쓰기 자동 정리 (ON/OFF) — 원본 파일과 줄 번호는 변경하지 않고 화면 표시만 가지런히 정렬합니다." />
                            <Button Style="{StaticResource FloatingEncodingButtonStyle}"
                                    Content="{Binding CurrentFileEncodingDisplay}"
                                    Click="CycleFileEncoding_Click"
                                    ToolTip="클릭하면 UTF-8 → CP949 → EUC-KR 순서로 바꿔 다시 읽습니다." />
                        </StackPanel>
                    </Grid>
                </DockPanel>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#3E3E42" />

                <!-- 중앙 하단: 결함 목록 / 규칙별 요약 / 노트 / 예외 항목 -->
                <TabControl Grid.Row="2" Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="0,1,0,0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Background" Value="#2D2D30" />
                            <Setter Property="Foreground" Value="#9DA7B3" />
                            <Setter Property="Padding" Value="12,6" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="#3E3E42" BorderThickness="1,1,1,0" Padding="{TemplateBinding Padding}" Margin="0,0,2,0" CornerRadius="4,4,0,0">
                                            <ContentPresenter ContentSource="Header" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#1E1E1E" />
                                                <Setter Property="Foreground" Value="#58A6FF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- 탭 1: 결함 및 규칙 위반 -->
                    <TabItem Header="{Binding DefectsTabHeader}">
                        <DockPanel Background="#1E1E1E">
                            <Border DockPanel.Dock="Top" Background="#252526" Padding="8,5" BorderBrush="#333337" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <WrapPanel>
                                        <TextBlock Text="분류 필터:" VerticalAlignment="Center" Foreground="#9DA7B3" Margin="0,0,6,0" />
                                        <ComboBox ItemsSource="{Binding DefectCategoryFilters}"
                                                  SelectedItem="{Binding SelectedDefectCategoryFilter}"
                                                  Width="145" Margin="0,0,14,0" VerticalAlignment="Center" />
                                        <TextBlock Text="결함 검색:" VerticalAlignment="Center" Foreground="#9DA7B3" Margin="0,0,6,0" />
                                        <TextBox Text="{Binding DefectSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="220" Padding="5,2" Background="#1E1E1E" Foreground="#E6EDF3" BorderBrush="#4E5157" />
                                        <TextBlock Text="  (우클릭하여 특정 줄 예외 처리 또는 규칙 전체 제외 가능)" VerticalAlignment="Center" Foreground="#6E7681" FontSize="11.5" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,5,0,0">
                                        <TextBlock Text="표시:" Foreground="#9DA7B3" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ToggleButton Content="오류" Foreground="#F85149" Style="{StaticResource SeverityToggleStyle}" IsChecked="{Binding ShowErrors, Mode=TwoWay}" />
                                        <ToggleButton Content="경고" Foreground="#D29922" Style="{StaticResource SeverityToggleStyle}" IsChecked="{Binding ShowWarnings, Mode=TwoWay}" />
                                        <ToggleButton Content="권고" Foreground="#58A6FF" Style="{StaticResource SeverityToggleStyle}" IsChecked="{Binding ShowAdvisories, Mode=TwoWay}" />
                                        <Button Content="오류만" Style="{StaticResource DarkButtonStyle}" Padding="8,2" Click="ShowOnlyErrors_Click" />
                                        <Button Content="모두 표시" Style="{StaticResource DarkButtonStyle}" Padding="8,2" Click="ShowAllSeverities_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <DataGrid x:Name="DefectsDataGrid"
                                      ItemsSource="{Binding FilteredDefects}"
                                      SelectedItem="{Binding SelectedIssue}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      Background="#1E1E1E"
                                      RowBackground="#252526"
                                      AlternatingRowBackground="#202022"
                                      Foreground="#E6EDF3"
                                      BorderThickness="0"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#333337"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      SelectionChanged="DefectsDataGrid_SelectionChanged">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="🔇 이 위치(파일:라인)의 결함만 예외(무시) 처리" Click="SuppressSingleIssue_Click" />
                                        <MenuItem Header="🚫 이 규칙(ID) 전체를 현재 프로젝트 검사에서 제외(OFF)" Click="DisableRuleEntirely_Click" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#2D2D30" />
                                        <Setter Property="Foreground" Value="#E6EDF3" />
                                        <Setter Property="Padding" Value="8,5" />
                                        <Setter Property="BorderBrush" Value="#3E3E42" />
                                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="6,4" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#094771" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="심각도" Width="62" SortMemberPath="ReviewSeverityRank">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="SeverityText" Text="{Binding ReviewSeverityDisplay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding ReviewSeverity}" Value="Error">
                                                        <Setter TargetName="SeverityText" Property="Foreground" Value="#FF6B6B" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ReviewSeverity}" Value="Warning">
                                                        <Setter TargetName="SeverityText" Property="Foreground" Value="#F2CC60" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ReviewSeverity}" Value="Advisory">
                                                        <Setter TargetName="SeverityText" Property="Foreground" Value="#79C0FF" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="분류" Binding="{Binding Category}" Width="120" />
                                    <DataGridTextColumn Header="규칙 ID" Binding="{Binding RuleId}" Width="155" FontFamily="{StaticResource CodingFont}" />
                                    <DataGridTextColumn Header="파일명" Binding="{Binding FileName}" Width="140" />
                                    <DataGridTextColumn Header="라인" Binding="{Binding Line}" Width="55" />
                                    <DataGridTextColumn Header="검출 내용 및 한글 요약" Binding="{Binding Message}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <!-- 규칙별 발생 건수와 발생 위치·코드 -->
                    <TabItem Header="{Binding RuleSummaryTabHeader}">
                        <DockPanel Background="#1E1E1E">
                            <Border DockPanel.Dock="Top" Background="#252526" Padding="8,5" BorderBrush="#333337" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <WrapPanel>
                                        <TextBlock Text="분류 필터:" VerticalAlignment="Center" Foreground="#9DA7B3" Margin="0,0,6,0" />
                                        <ComboBox ItemsSource="{Binding DefectCategoryFilters}" SelectedItem="{Binding SelectedDefectCategoryFilter}"
                                                  Width="145" Margin="0,0,14,0" VerticalAlignment="Center" />
                                        <TextBlock Text="결함 검색:" VerticalAlignment="Center" Foreground="#9DA7B3" Margin="0,0,6,0" />
                                        <TextBox Text="{Binding DefectSearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                                 Width="220" Padding="5,2" Background="#1E1E1E" Foreground="#E6EDF3" BorderBrush="#4E5157" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,5,0,0">
                                        <TextBlock Text="표시:" Foreground="#9DA7B3" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ToggleButton Content="오류" Foreground="#F85149" Style="{StaticResource SeverityToggleStyle}" IsChecked="{Binding ShowErrors, Mode=TwoWay}" />
                                        <ToggleButton Content="경고" Foreground="#D29922" Style="{StaticResource SeverityToggleStyle}" IsChecked="{Binding ShowWarnings, Mode=TwoWay}" />
                                        <ToggleButton Content="권고" Foreground="#58A6FF" Style="{StaticResource SeverityToggleStyle}" IsChecked="{Binding ShowAdvisories, Mode=TwoWay}" />
                                        <Button Content="오류만" Style="{StaticResource DarkButtonStyle}" Padding="8,2" Click="ShowOnlyErrors_Click" />
                                        <Button Content="모두 표시" Style="{StaticResource DarkButtonStyle}" Padding="8,2" Click="ShowAllSeverities_Click" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding RuleSummaryStatusText}" Foreground="#9DA7B3" FontSize="11.5" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Grid>
                                <TreeView ItemsSource="{Binding RuleIssueGroups}" Background="#1E1E1E" BorderThickness="0"
                                          Foreground="#E6EDF3" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                          SelectedItemChanged="RuleSummaryTree_SelectedItemChanged">
                                    <TreeView.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="모두 접기" Click="RuleSummaryCollapseAll_Click" />
                                            <MenuItem Header="모두 펼치기" Click="RuleSummaryExpandAll_Click" />
                                        </ContextMenu>
                                    </TreeView.ContextMenu>
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                    <TreeView.Resources>
                                        <HierarchicalDataTemplate DataType="{x:Type models:RuleIssueGroup}" ItemsSource="{Binding Occurrences}">
                                            <HierarchicalDataTemplate.ItemContainerStyle>
                                                <Style TargetType="TreeViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </HierarchicalDataTemplate.ItemContainerStyle>
                                            <TextBlock Text="{Binding Header}" Foreground="#F2CC60" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,6" />
                                        </HierarchicalDataTemplate>
                                        <DataTemplate DataType="{x:Type models:RuleIssueOccurrence}">
                                            <StackPanel Margin="4,3,12,5" ToolTip="{Binding Issue.Message}">
                                                <TextBlock x:Name="OccurrenceLocation" Text="{Binding Location}" Foreground="#79C0FF" FontSize="11.5" TextWrapping="Wrap" />
                                                <TextBlock x:Name="OccurrenceCode" Text="{Binding CodeText}" Foreground="#E6EDF3" FontFamily="{StaticResource CodingFont}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                                    <Setter TargetName="OccurrenceLocation" Property="Foreground" Value="White" />
                                                    <Setter TargetName="OccurrenceCode" Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </TreeView.Resources>
                                </TreeView>
                                <TextBlock Text="표시할 진단이 없습니다. 분석 결과와 검색·분류·심각도 조건을 확인하십시오."
                                           Foreground="#9DA7B3" Margin="12" TextWrapping="Wrap" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RuleIssueGroups.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </TabItem>

                    <!-- 노트 / 누락 헤더 안내 -->
                    <TabItem Header="{Binding NotesTabHeader}">
                        <DockPanel Background="#1E1E1E">
                            <Border DockPanel.Dock="Top" Background="#252526" Padding="8,5" BorderBrush="#333337" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <Button Content="🔍 폴더에서 누락 헤더 일괄 검색 및 참조 추가..."
                                            DockPanel.Dock="Right"
                                            Style="{StaticResource DarkButtonStyle}"
                                            Padding="10,2"
                                            FontWeight="SemiBold"
                                            Click="SearchAllMissingHeaders_Click"
                                            ToolTip="상위 폴더를 선택하면 하위 모든 폴더를 탐색하여 누락된 헤더들을 찾아 참조 코드(비대상)에 한꺼번에 추가합니다." />
                                    <TextBlock Text="누락된 포함 파일(#include) 행에서 우클릭하거나 우측 버튼을 눌러 하위 폴더에서 헤더를 일괄 검색해 참조 코드에 추가할 수 있습니다."
                                               VerticalAlignment="Center"
                                               Foreground="#9DA7B3" />
                                </DockPanel>
                            </Border>

                            <DataGrid x:Name="NotesDataGrid"
                                      ItemsSource="{Binding NotesAndInfos}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Background="#1E1E1E"
                                  RowBackground="#252526"
                                  AlternatingRowBackground="#202022"
                                  Foreground="#9DA7B3"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#333337"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0"
                                  SelectionChanged="NotesDataGrid_SelectionChanged">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="🔍 모든 누락 헤더를 폴더에서 일괄 검색하여 참조 코드에 추가..." Click="SearchAllMissingHeaders_Click" />
                                        <MenuItem Header="🔍 선택한 줄의 누락 헤더만 폴더에서 검색하여 참조 코드에 추가..." Click="SearchSelectedMissingHeader_Click" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#2D2D30" />
                                    <Setter Property="Foreground" Value="#E6EDF3" />
                                    <Setter Property="Padding" Value="8,5" />
                                    <Setter Property="BorderBrush" Value="#3E3E42" />
                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="구분" Binding="{Binding Title}" Width="180" />
                                <DataGridTextColumn Header="파일명" Binding="{Binding FileName}" Width="150" />
                                <DataGridTextColumn Header="라인" Binding="{Binding Line}" Width="60" />
                                <DataGridTextColumn Header="상세 참고 안내" Binding="{Binding Message}" Width="*" />
                            </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <!-- 예외(무시) 처리된 항목 -->
                    <TabItem Header="{Binding SuppressedTabHeader}">
                        <DockPanel Background="#1E1E1E">
                            <Border DockPanel.Dock="Top" Background="#252526" Padding="8,5">
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Content="↩ 선택 항목 예외 해제(복원)" Style="{StaticResource DarkButtonStyle}" Click="RestoreSuppressed_Click" />
                                        <Button Content="전체 복원" Style="{StaticResource DarkButtonStyle}" Click="RestoreAllSuppressed_Click" />
                                    </StackPanel>
                                    <TextBlock Text="개별 위치 예외(무시) 처리된 결함 목록입니다. 각 행의 [복원] 버튼이나 우클릭으로 언제든 원래 결함 목록으로 되돌릴 수 있습니다." VerticalAlignment="Center" Foreground="#9DA7B3" />
                                </DockPanel>
                            </Border>
                            <DataGrid x:Name="SuppressedDataGrid"
                                      ItemsSource="{Binding SuppressedIssues}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Background="#1E1E1E"
                                      RowBackground="#252526"
                                      AlternatingRowBackground="#202022"
                                      Foreground="#E6EDF3"
                                      BorderThickness="0"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      SelectionChanged="SuppressedDataGrid_SelectionChanged">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="↩ 이 항목의 예외 처리 해제 (결함 목록으로 복원)" Click="RestoreSuppressed_Click" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#2D2D30" />
                                        <Setter Property="Foreground" Value="#E6EDF3" />
                                        <Setter Property="Padding" Value="8,5" />
                                        <Setter Property="BorderBrush" Value="#3E3E42" />
                                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="복원" Width="72">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="↩ 복원" Style="{StaticResource DarkButtonStyle}" Padding="6,1" FontSize="11"
                                                        Click="RestoreRowButton_Click" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="규칙 ID" Binding="{Binding RuleId}" Width="160" FontFamily="{StaticResource CodingFont}" />
                                    <DataGridTextColumn Header="파일 경로" Binding="{Binding FilePath}" Width="240" />
                                    <DataGridTextColumn Header="라인" Binding="{Binding Line}" Width="60" />
                                    <DataGridTextColumn Header="상태" Binding="{Binding ReviewDisplay}" Width="80" />
                                    <DataGridTextColumn Header="무시된 결함 내용" Binding="{Binding Message}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Grid>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#3E3E42" />

            <!-- 2.3 우측 패널: 선택한 결함의 상세 한글 해설 및 위반/개선 코드 예시 -->
            <Border Grid.Column="4" Background="#252526" Padding="12">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="10,7" Margin="0,0,0,10">
                        <TextBlock Text="📖 결함 및 규칙 상세 설명" FontWeight="Bold" FontSize="14" Foreground="#E6EDF3" />
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Visibility="{Binding HasSelectedIssue, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <!-- 규칙 헤더 -->
                            <Border Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <WrapPanel Margin="0,0,0,4">
                                        <Border Background="#094771" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding SelectedIssue.Category}" FontSize="11" FontWeight="Bold" Foreground="#79C0FF" />
                                        </Border>
                                        <Border Background="#3B2E12" CornerRadius="3" Padding="6,2">
                                            <TextBlock Text="{Binding SelectedIssue.ObligationDisplay}" FontSize="11" FontWeight="Bold" Foreground="#F2CC60" TextWrapping="Wrap" />
                                        </Border>
                                    </WrapPanel>

                                    <TextBlock Text="{Binding SelectedIssue.RuleId}" FontFamily="{StaticResource CodingFont}" FontSize="13" FontWeight="Bold" Foreground="#FF7B72" Margin="0,2,0,2" />
                                    <TextBlock Text="{Binding SelectedIssue.Title}" FontSize="14.5" FontWeight="Bold" Foreground="#E6EDF3" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0" FontSize="11.5" Foreground="#9DA7B3">
                                        <Run Text="위치: " />
                                        <Run Text="{Binding SelectedIssue.FileName, Mode=OneWay}" FontWeight="Bold" />
                                        <Run Text=" (" />
                                        <Run Text="{Binding SelectedIssue.Line, Mode=OneWay}" FontWeight="Bold" />
                                        <Run Text="번째 줄)" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- 빠른 예외 처리 / 해제 토글 버튼 -->
                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <Button Content="{Binding SelectedIssueToggleButtonText}" Style="{StaticResource DarkButtonStyle}" Click="ToggleSelectedIssueSuppression_Click" />
                                <Button Content="🚫 이 규칙 전체 끄기" Style="{StaticResource DarkButtonStyle}" Click="DisableRuleEntirely_Click" />
                            </UniformGrid>

                            <!-- 검출된 코드 진단 내용 -->
                            <TextBlock Text="🔍 검출된 코드 진단" FontWeight="Bold" Foreground="#58A6FF" Margin="0,0,0,4" />
                            <Border Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                                <TextBlock Text="{Binding SelectedIssue.Message}" Foreground="#E6EDF3" TextWrapping="Wrap" LineHeight="19" />
                            </Border>

                            <!-- 왜 위험한가 (임베디드 상세 해설) -->
                            <TextBlock Text="💡 왜 위험한가? (임베디드 상세 해설)" FontWeight="Bold" Foreground="#58A6FF" Margin="0,0,0,4" />
                            <Border Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                                <TextBlock Text="{Binding SelectedIssue.RuleDetails.Description}" Foreground="#D0D7DE" TextWrapping="Wrap" LineHeight="20" />
                            </Border>

                            <!-- 위반 코드 예시 (Bad) -->
                            <TextBlock Text="❌ 위반 코드 예시 (Bad)" FontWeight="Bold" Foreground="#F85149" Margin="0,0,0,4" />
                            <Border Background="#1A1415" BorderBrush="#6E3630" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                                <TextBlock Text="{Binding SelectedIssue.RuleDetails.BadExampleDisplay}"
                                           FontFamily="{StaticResource CodingFont}" FontSize="12" Foreground="#E6EDF3" TextWrapping="Wrap" />
                            </Border>

                            <!-- 개선 코드 예시 (Good) -->
                            <TextBlock Text="✅ 개선 방향 및 코드 예시 (Good)" FontWeight="Bold" Foreground="#3FB950" Margin="0,0,0,4" />
                            <Border Background="#131F17" BorderBrush="#238636" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                <TextBlock Text="{Binding SelectedIssue.RuleDetails.GoodExampleDisplay}"
                                           FontFamily="{StaticResource CodingFont}" FontSize="12" Foreground="#E6EDF3" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 3. 하단 상태 표시줄 -->
        <Border Grid.Row="2" Background="#007ACC" Padding="12,3">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding SelectedTargetPreset.Architecture}"
                           Foreground="#FFFFFF"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#FFFFFF"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
