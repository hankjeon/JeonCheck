<Application x:Class="JeonCheck.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- 내장 D2Coding 고정폭 코딩 폰트 및 폴백 설정 -->
        <FontFamily x:Key="CodingFont">pack://application:,,,/Resources/Fonts/#D2Coding, Cascadia Mono, Consolas, Malgun Gothic</FontFamily>

        <!-- VS Code 스타일 모던 다크 테마 브러시 -->
        <SolidColorBrush x:Key="BgEditorBrush" Color="#1E1E1E" />
        <SolidColorBrush x:Key="BgPanelBrush" Color="#252526" />
        <SolidColorBrush x:Key="BgToolbarBrush" Color="#2D2D30" />
        <SolidColorBrush x:Key="BgHeaderBrush" Color="#333337" />
        <SolidColorBrush x:Key="BorderDarkBrush" Color="#3E3E42" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6EDF3" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9DA7B3" />
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#0E639C" />
        <SolidColorBrush x:Key="AccentGreenBrush" Color="#2EA043" />

        <!-- 다크 버튼 스타일 -->
        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3A3D41" />
            <Setter Property="Foreground" Value="#E6EDF3" />
            <Setter Property="BorderBrush" Value="#4E5157" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4B4F55" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D2F33" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 강조 실행 버튼 스타일 (분석 중 녹색 진행률 게이지 차오름 지원) -->
        <Style x:Key="PrimaryRunButtonStyle" TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}">
            <Setter Property="Background" Value="#238636" />
            <Setter Property="BorderBrush" Value="#2EA043" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="MinWidth" Value="155" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                ClipToBounds="True">
                            <Grid>
                                <!-- 분석 진행 중일 때 왼쪽에서 오른쪽으로 녹색이 차오르는 ProgressBar -->
                                <ProgressBar x:Name="progressFill"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding AnalysisProgressPercent, Mode=OneWay}"
                                             Background="#122618"
                                             Foreground="#2EA043"
                                             BorderThickness="0"
                                             Visibility="Collapsed" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2EA043" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsAnalyzing}" Value="True">
                                <Setter TargetName="progressFill" Property="Visibility" Value="Visible" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#3FB950" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsEnabled}" Value="False" />
                                    <Condition Binding="{Binding IsAnalyzing}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Opacity" Value="0.5" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
